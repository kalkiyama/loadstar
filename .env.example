# ─── Loadstar configuration ───────────────────────────────────
# Copy this file to .env and fill in your values:  cp .env.example .env
# Never commit your real .env — it's gitignored for a reason.

# ─── AI analysis (optional) ───────────────────────────────────
# Claude analyzes each run (verdict, findings, trends). Get a key at
# https://console.anthropic.com — leave blank to disable AI analysis.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ─── Auth (set when deploying anywhere shared) ────────────────
# When set, the API requires an X-API-Key header. Leave blank for local dev.
LOADSTAR_API_KEY=

# ─── Test limits (guardrails) ─────────────────────────────────
MAX_BROWSER_USERS=5
BROWSER_STEP_TIMEOUT_MS=30000
ALERT_ERROR_RATE_PCT=5

# ─── Target safety (SSRF protection) ──────────────────────────
# Allow testing http://localhost / private IPs. Fine for local dev;
# set to false anywhere shared. NEVER enable SKIP_TARGET_VERIFICATION
# outside local development — it disables the anti-DDoS domain check.
ALLOW_PRIVATE_TARGETS=false
SKIP_TARGET_VERIFICATION=false

# How many load generators the launcher starts. Default 1.
#
# Distributed runs split one test across several worker containers and merge the
# raw histogram bins, so percentiles stay exact. The controller is ITSELF a worker
# and BLOCKS while coordinating, so a test needing N shards needs N+1 workers —
# with fewer, the shard rows are created and nobody is left to claim them.
# Loadstar refuses up front rather than deadlocking.
#
# BE CLEAR ABOUT WHAT THIS BUYS YOU: on ONE machine the generators contend for the
# same CPU. A 5000-VU run on a 4-vCPU box saturated at 0.97 with a single worker;
# splitting it three ways does not create capacity, it divides the same capacity
# into smaller pieces. Distribution pays off across SEPARATE MACHINES. This setting
# exists so the feature is reachable without memorising `--scale`, not because more
# workers make a laptop faster.
LOADSTAR_WORKERS=1

# TLS-only security headers. Loadstar serves PLAIN HTTP; helmet's defaults assume
# otherwise and, left on, break the UI on Safari and Chromium (upgrade-insecure-requests
# re-fetches app.js/styles.css over https://, which this server does not speak) and pin
# HSTS on the ORIGIN for a year — poisoning localhost for every other local dev server.
# Set true ONLY when a reverse proxy actually terminates TLS in front of Loadstar.
LOADSTAR_BEHIND_TLS=false

# ─── Email reports (optional — needs an SMTP server) ──────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
REPORT_EMAIL_TO=

# ─── App ──────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8080

# ─── Test-only scaffolding (leave false in normal use) ────────
# Enables the mock auth + webhook-catch endpoints used for testing
# response chaining and webhook delivery. Not for production.
ENABLE_MOCK_AUTH=false

# ---- Limits: you decide, not Loadstar ----
# Virtual users a single test may request.
MAX_VIRTUAL_USERS=1000

# Longest a test may run, in seconds. Set to 0 for NO LIMIT.
# Note: a long soak holds a worker for its whole duration — other tests queue
# behind it. Scale workers (docker compose up --scale worker=N) if that matters.
MAX_DURATION_SECS=3600

# Distributed load generation.
#   DISTRIBUTION_VU_THRESHOLD — fan out above this many VUs.
#   MAX_SHARDS — the most generators one test may use.
# WARNING: generators on the SAME machine contend for the same CPU. Raising these
# without running generators on separate machines means you measure your own
# hardware, not the target. See "Distributed load generation" in USAGE.md.
DISTRIBUTION_VU_THRESHOLD=100
MAX_SHARDS=10

# Browser tests — real Chromium processes, far heavier than an HTTP virtual user.
MAX_BROWSER_USERS=5
MAX_BROWSER_LOOPS=10
